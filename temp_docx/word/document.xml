extId="77777777" w:rsidR="00FB285D" w:rsidRPr="00FB285D" w:rsidRDefault="00FB285D" w:rsidP="00FB285D"><w:pPr><w:spacing w:line="360" w:lineRule="auto"/><w:jc w:val="both"/><w:rPr><w:rFonts w:asciiTheme="majorBidi" w:hAnsiTheme="majorBidi" w:cstheme="majorBidi"/></w:rPr></w:pPr><w:r w:rsidRPr="00FB285D"><w:rPr><w:rFonts w:asciiTheme="majorBidi" w:hAnsiTheme="majorBidi" w:cstheme="majorBidi"/></w:rPr><w:t xml:space="preserve">Projenin temel amacı: kafe, fırın ve restoran gibi işletmelerin gün sonunda satılamayan ancak tüketim kalitesini koruyan ürünlerini </w:t></w:r><w:r w:rsidRPr="00FB285D"><w:rPr><w:rFonts w:asciiTheme="majorBidi" w:hAnsiTheme="majorBidi" w:cstheme="majorBidi"/><w:b/><w:bCs/></w:rPr><w:t>'Sürpriz Çanta'</w:t></w:r><w:r w:rsidRPr="00FB285D"><w:rPr><w:rFonts w:asciiTheme="majorBidi" w:hAnsiTheme="majorBidi" w:cstheme="majorBidi"/></w:rPr><w:t xml:space="preserve"> konseptiyle paketleyerek kullanıcıya sunduğu, coğrafi konum tabanlı bir mobil pazar yeri geliştirmektir. Tüketiciler, bu uygulama üzerinden konumlarına en yakın ürünleri keşfederek indirimli fiyatlarla rezerve edebilmektedir.</w:t></w:r></w:p><w:p w14:paraId="0FADC151" w14:textId="77777777" w:rsidR="00FB285D" w:rsidRPr="00FB285D" w:rsidRDefault="00FB285D" w:rsidP="00FB285D"><w:pPr><w:spacing w:line="360" w:lineRule="auto"/><w:jc w:val="both"/><w:rPr><w:rFonts w:asciiTheme="majorBidi" w:hAnsiTheme="majorBidi" w:cstheme="majorBidi"/></w:rPr></w:pPr><w:r w:rsidRPr="00FB285D"><w:rPr><w:rFonts w:asciiTheme="majorBidi" w:hAnsiTheme="majorBidi" w:cstheme="majorBidi"/></w:rPr><w:t>Bu projenin önemi, iki taraflı pazar yerlerinde karşılaşılan operasyonel sorunlara getirdiği yenilikçi çözümde yatmaktadır. Projenin temel paydaşlara sağladığı katkılar şu şekilde özetlenebilir:</w:t></w:r></w:p><w:p w14:paraId="17DE073C" w14:textId="77777777" w:rsidR="00FB285D" w:rsidRPr="00FB285D" w:rsidRDefault="00FB285D" w:rsidP="00FB285D"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:line="360" w:lineRule="auto"/><w:jc w:val="both"/><w:rPr><w:rFonts w:asciiTheme="majorBidi" w:hAnsiTheme="majorBidi" w:cstheme="majorBidi"/></w:rPr></w:pPr><w:r w:rsidRPr="00FB285D"><w:rPr><w:rFonts w:asciiTheme="majorBidi" w:hAnsiTheme="majorBidi" w:cstheme="majorBidi"/><w:b/><w:bCs/></w:rPr><w:t>İşletmeler Açısından:</w:t></w:r><w:r w:rsidRPr="00FB285D"><w:rPr><w:rFonts w:asciiTheme="majorBidi" w:hAnsiTheme="majorBidi" w:cstheme="majorBidi"/></w:rPr><w:t xml:space="preserve"> Yoğun kapanış saatlerinde spesifik ürün sayımı ve envanter girişi yapma zorunluluğunu ortadan kaldırır. Bu durum işletmelerin sisteme entegrasyonunu kolaylaştırırken, normal şartlarda oluşacak atık maliyetlerini ek gelire dönüştürür.</w:t></w:r></w:p><w:p w14:paraId="0CF81347" w14:textId="1989A198" w:rsidR="00F14B1A" w:rsidRPr="00FB285D" w:rsidRDefault="00FB285D" w:rsidP="00FB285D"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:line="360" w:lineRule="auto"/><w:jc w:val="both"/><w:rPr><w:rFonts w:asciiTheme="majorBidi" w:hAnsiTheme="majorBidi" w:cstheme="majorBidi"/></w:rPr></w:pPr><w:r w:rsidRPr="00FB285D"><w:rPr><w:rFonts w:asciiTheme="majorBidi" w:hAnsiTheme="majorBidi" w:cstheme="majorBidi"/><w:b/><w:bCs/></w:rPr><w:t>Tüketiciler Açısından:</w:t></w:r><w:r w:rsidRPr="00FB285D"><w:rPr><w:rFonts w:asciiTheme="majorBidi" w:hAnsiTheme="majorBidi" w:cstheme="majorBidi"/></w:rPr><w:t xml:space="preserve"> Artan yaşam maliyetleri karşısında, kaliteli ve taze gıdaya çok daha erişilebilir fiyatlarla ulaşım imkânı sunar.</w:t></w:r></w:p></w:tc></w:tr><w:bookmarkEnd w:id="0"/></w:tbl><w:p w14:paraId="0CF81349" w14:textId="77777777" w:rsidR="008E18EC" w:rsidRDefault="008E18EC" w:rsidP="00901EBF"><w:pPr><w:spacing w:after="0" w:line="240" w:lineRule="auto"/><w:rPr><w:rFonts w:asciiTheme="majorBidi" w:hAnsiTheme="majorBidi" w:cstheme="majorBidi"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr></w:p><w:tbl><w:tblPr><w:tblStyle w:val="TabloKlavuzu"/><w:tblW w:w="9878"