# Replace with the exact DuckDNS hostname configured for this server.
DOMAIN=your-name.duckdns.org

# Generate each value on the server with: openssl rand -hex 32
DB_PASSWORD=replace-with-a-random-64-character-hex-value
AUTH_SECRET=replace-with-a-different-random-64-character-hex-value

# Optional. Needed only to show the Google map on the web app.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
